{
  "name": "alien-rpg-tools",
  "private": true,
  "version": "1.3.2",
  "description": "A suite of Alien RPG generators and calculators by Ties That Bind Gaming, available as a desktop app and playable in the browser.",
  "author": {
    "name": "Ties That Bind Gaming",
    "email": "support@tiesthatbindgaming.com"
  },
  "type": "module",
  "main": "public/electron.js",
  "homepage": "./",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abstrengin/alien-rpg.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --config vite.config.web.js",
    "preview": "vite preview",
    "preview:web": "vite preview --config vite.config.web.js",
    "lint": "eslint . --fix",
    "electron-dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_IS_DEV=true electron .\"",
    "electron-build": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always",
    "win:icon": "node scripts/gen-win-icon.mjs",
    "android:icons": "node scripts/gen-android-icons.mjs",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease"
  },
  "build": {
    "appId": "com.tiesthatbindgaming.ttbgtools",
    "productName": "Alien RPG Tools",
    "directories": {
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/electron-index.html",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/alien-rpg-tools.ico",
      "artifactName": "${productName} Portable ${version}.${ext}",
      "compression": "store"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "axios": "^1.7.9",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/forms": "^0.5.7",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "postcss": "^8.4.33",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.1",
    "wait-on": "^9.0.3"
  }
}
